# Chave PUBLICÁVEL da instância Clerk correspondente ao ambiente.
# Desenvolvimento/Preview: pk_test_...; produção: pk_live_...
# Configure na Vercel em Project > Settings > Environment Variables.
CLERK_PUBLISHABLE_KEY=pk_test_substitua_pela_chave_publicavel

# Valores PUBLICÁVEIS do projeto Supabase correspondente ao ambiente.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_substitua_pela_chave_publicavel

# Nunca adicione CLERK_SECRET_KEY, SUPABASE_SECRET_KEY ou service_role ao frontend.
